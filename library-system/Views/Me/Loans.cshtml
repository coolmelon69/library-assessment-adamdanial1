@model MeLoansViewModel

@{
    ViewData["Title"] = "My Loans";
}

<section class="account-header">
    <div>
        <p class="landing-eyebrow">Active borrowing</p>
        <h1>My Loans</h1>
        <p class="text-muted mb-0">Only active loans for the currently signed-in member are shown.</p>
    </div>
    <a class="btn btn-outline-dark" asp-controller="Me" asp-action="GetMe">My profile</a>
</section>

@if (TempData["MeSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["MeErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<section class="account-panel">
    <div class="account-section-heading">
        <div>
            <p class="borrow-eyebrow">Loans</p>
            <h2>@Model.Loans.Count active loan@(Model.Loans.Count == 1 ? "" : "s")</h2>
        </div>
        <a asp-controller="Catalog" asp-action="Index">Browse catalog</a>
    </div>

    @if (Model.Loans.Count == 0)
    {
        <div class="account-empty">
            You do not have any active loans.
        </div>
    }
    else
    {
        <div class="loan-list">
            @foreach (var loan in Model.Loans)
            {
                <article class="loan-list-item">
                    <div>
                        <h3>@loan.BookTitle</h3>
                        <p>@loan.BookAuthor</p>
                        <span>Borrowed @loan.BorrowedDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <form asp-controller="Me" asp-action="ReturnLoan" asp-route-loanId="@loan.Id" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Return</button>
                    </form>
                </article>
            }
        </div>
    }
</section>
