@model CatalogIndexViewModel

@{
    ViewData["Title"] = "Admin Books";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1>Admin Books</h1>
        <p class="text-muted mb-0">@Model.Books.Count book@(Model.Books.Count == 1 ? "" : "s") found</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create book</a>
</div>

@if (TempData["AdminBooksSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-12 col-md-5">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control" autocomplete="off" />
    </div>
    <div class="col-12 col-md-5">
        <label asp-for="Author" class="form-label">Author</label>
        <input asp-for="Author" class="form-control" autocomplete="off" />
    </div>
    <div class="col-12 col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
</form>

@if (Model.Books.Count == 0)
{
    <div class="alert alert-light border" role="status">No books match the current filters.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Author</th>
                    <th scope="col">ISBN</th>
                    <th scope="col">Year</th>
                    <th scope="col">Copies</th>
                    <th scope="col">Available</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
                    <td>@book.Author</td>
                    <td><span class="text-nowrap">@book.ISBN</span></td>
                    <td>@book.PublishedYear</td>
                    <td>@book.TotalCopies</td>
                    <td>@book.AvailableCopies</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Book actions">
                            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@book.Id">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
