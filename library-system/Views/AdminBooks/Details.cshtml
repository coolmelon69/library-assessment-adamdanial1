@model BookDetailsResponse

@{
    ViewData["Title"] = Model.Title;
}

<nav class="mb-3">
    <a asp-action="Index">Back to admin books</a>
</nav>

@if (TempData["AdminBooksSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["AdminBooksErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-muted mb-2">@Model.Author</p>
        <h1>@Model.Title</h1>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>
    <dt class="col-sm-3">Published year</dt>
    <dd class="col-sm-9">@Model.PublishedYear</dd>
    <dt class="col-sm-3">Total copies</dt>
    <dd class="col-sm-9">@Model.TotalCopies</dd>
    <dt class="col-sm-3">Available copies</dt>
    <dd class="col-sm-9">@Model.AvailableCopies</dd>
</dl>
